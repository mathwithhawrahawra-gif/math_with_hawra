{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the Math With Hawra visual language. Edit values here only -- do not hand-edit generated theme files. Colors are authored as hex; the generator converts them to HSL channels for web and keeps hex for mobile. Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fff7fa", "$description": "Soft blush page background used behind the glass surfaces." },
      "foreground": { "$value": "#351423" },
      "border": { "$value": "#f4d7e3" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#351423" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#351423" },
      "primary": {
        "$value": "#ff6b9d",
        "$description": "Hawra pink: primary actions, links, headings, and teacher emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#ffd166", "$description": "Sun yellow: student actions, progress, and warm highlights." },
      "secondaryForeground": { "$value": "#4a2b00" },
      "muted": { "$value": "#fff0f5" },
      "mutedForeground": { "$value": "#8a6270" },
      "accent": { "$value": "#a855d6", "$description": "Playful purple accent for supporting emphasis and selected states." },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#f4d7e3" },
      "ring": { "$value": "#ff6b9d" },
      "chart1": { "$value": "#ff6b9d" },
      "chart2": { "$value": "#ffd166" },
      "chart3": { "$value": "#a855d6" },
      "chart4": { "$value": "#60a5fa" },
      "chart5": { "$value": "#34c38f" },
      "sidebar": { "$value": "#fff0f5" },
      "sidebarForeground": { "$value": "#351423" },
      "sidebarBorder": { "$value": "#f4d7e3" },
      "sidebarPrimary": { "$value": "#ff6b9d" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#ffe4ee" },
      "sidebarAccentForeground": { "$value": "#351423" },
      "sidebarRing": { "$value": "#ff6b9d" }
    },
    "dark": {
      "background": { "$value": "#21131d" },
      "foreground": { "$value": "#fff4f8" },
      "border": { "$value": "#573146" },
      "card": { "$value": "#2d1a29" },
      "cardForeground": { "$value": "#fff4f8" },
      "popover": { "$value": "#2d1a29" },
      "popoverForeground": { "$value": "#fff4f8" },
      "primary": { "$value": "#ff78a6" },
      "primaryForeground": { "$value": "#351423" },
      "secondary": { "$value": "#ffd166" },
      "secondaryForeground": { "$value": "#4a2b00" },
      "muted": { "$value": "#3a2234" },
      "mutedForeground": { "$value": "#ddb9c9" },
      "accent": { "$value": "#c17be6" },
      "accentForeground": { "$value": "#351423" },
      "destructive": { "$value": "#f87171" },
      "destructiveForeground": { "$value": "#351423" },
      "input": { "$value": "#573146" },
      "ring": { "$value": "#ff78a6" },
      "chart1": { "$value": "#ff78a6" },
      "chart2": { "$value": "#ffd166" },
      "chart3": { "$value": "#c17be6" },
      "chart4": { "$value": "#7eb6ff" },
      "chart5": { "$value": "#55d5a5" },
      "sidebar": { "$value": "#2d1a29" },
      "sidebarForeground": { "$value": "#fff4f8" },
      "sidebarBorder": { "$value": "#573146" },
      "sidebarPrimary": { "$value": "#ff78a6" },
      "sidebarPrimaryForeground": { "$value": "#351423" },
      "sidebarAccent": { "$value": "#3a2234" },
      "sidebarAccentForeground": { "$value": "#fff4f8" },
      "sidebarRing": { "$value": "#ff78a6" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Tajawal", "sans-serif"],
        "$description": "Arabic-first UI and body typeface used by the application."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Friendly rounded base; larger treatments create the app's pill and glass-card language."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel rhythm used for compact controls and generous educational layouts."
    }
  }
}
